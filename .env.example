# ---------------------------------------------------------------------------
# Sylva platform - environment configuration
#
# Hosting and database must both sit in a NAMED EU member-state region
# (Frankfurt, Paris or Dublin). A generic "Europe" region is not acceptable:
# it can include London or Zurich. See docs/DECISIONS.md.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
PGHOST=127.0.0.1
PGPORT=5455
PGDATABASE=sylva_dev
PGSSLMODE=require            # 'disable' for local development only

# One login role per trust boundary. None of these is a superuser and none
# holds BYPASSRLS; db/migrations/0018 asserts it on every run.
SYLVA_DB_PUBLIC_USER=sylva_login_public        # anonymous visitors
SYLVA_DB_PUBLIC_PASSWORD=
SYLVA_DB_APP_USER=sylva_login_app              # buyer / project owner / investor
SYLVA_DB_APP_PASSWORD=
SYLVA_DB_OPERATOR_USER=sylva_login_operator    # Sylva staff
SYLVA_DB_OPERATOR_PASSWORD=
SYLVA_DB_AUDITOR_USER=sylva_login_auditor      # read-only, funder and external
SYLVA_DB_AUDITOR_PASSWORD=

PG_POOL_MAX=10
PG_STATEMENT_TIMEOUT_MS=5000

# How long a minted actor context stays valid. Short: it is re-minted per
# request anyway, and a short life caps replay of a captured context.
SYLVA_CTX_TTL="15 minutes"

# --- Application ----------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SYLVA_SESSION_COOKIE=sylva_session
SYLVA_SESSION_TTL_HOURS=12

# --- Documents ------------------------------------------------------------
# Object storage in a named EU region. Private buckets only: a document is
# never served from a public URL, always through an authorised signed URL.
SYLVA_STORAGE_DRIVER=local                     # local | s3
SYLVA_STORAGE_LOCAL_DIR=./.storage
SYLVA_S3_REGION=eu-central-1                   # Frankfurt
SYLVA_S3_BUCKET=
SYLVA_S3_ENDPOINT=
SYLVA_S3_ACCESS_KEY_ID=
SYLVA_S3_SECRET_ACCESS_KEY=
SYLVA_SIGNED_URL_TTL_SECONDS=120

# --- Map ------------------------------------------------------------------
# Basemap tiles are a data-protection question, not only a rendering one:
# a tile request discloses what the visitor is looking at to whoever serves it.
# OPEN DECISION - see docs/DECISIONS.md. Default to an EU-hosted style.
SYLVA_MAP_STYLE_URL=
SYLVA_MAP_ATTRIBUTION=

# --- Analytics ------------------------------------------------------------
# Self-hosted or EU-hosted, no third-party trackers, no cross-site identifiers.
SYLVA_ANALYTICS_DRIVER=none                    # none | plausible-selfhosted
SYLVA_ANALYTICS_HOST=

# --- EU funding notice ----------------------------------------------------
# The emblem asset and the exact disclaimer sentence come from the grant
# agreement and must NOT be invented. Until supplied, the footer renders a
# visible placeholder rather than guessed wording.
SYLVA_EU_DISCLAIMER_EN=
SYLVA_EU_DISCLAIMER_DE=
